{
  "name": "dsh-frameless-page",
  "displayName": "灵动岛窗口",
  "version": "0.1.33",
  "description": "DSH-Portable 的顶部灵动岛胶囊窗口 UI：待机三点、悬停描边、单击展开、拖动窗口、原生菜单与窗口控制，宽度不足时自动折叠菜单。",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "dynamic-island",
    "window-chrome"
  ],
  "license": "MIT",
  "author": "ArtificialAngels",
  "type": "module",
  "engines": {
    "node": ">=22.17.0",
    "dsh": "0.2.1-rc.2"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "icon": "./assets/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtificialAngels/dsh-frameless-page.git"
  },
  "homepage": "https://github.com/ArtificialAngels/dsh-frameless-page#readme",
  "bugs": {
    "url": "https://github.com/ArtificialAngels/dsh-frameless-page/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "pack": "node scripts/build-client.mjs && pnpm pack --pack-destination .artifacts"
  }
}
